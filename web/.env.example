# Build-time: where the Wagtail API lives (server-side only, never shipped to the browser)
WAGTAIL_API_URL=http://127.0.0.1:8000/api/v2
# Prefix for relative /media/ URLs from the API. Same origin in production -> empty.
WAGTAIL_MEDIA_URL=http://127.0.0.1:8000
# Public values (inlined into the client bundle)
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_FORMS_API_URL=http://127.0.0.1:8000/api/forms
