---
import "@/styles/global.css";
import type { ApiImage, Navigation, Settings } from "@/lib/types";
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";
import FitHeadings from "@/components/ui/FitHeadings.astro";
import { MEDIA_ORIGIN } from "@/lib/wagtail";
import { originOf, sha256, sources } from "@/lib/csp";
import { FIT_HEADINGS_SCRIPT } from "@/lib/fit-headings";
interface Props {
  settings: Settings;
  nav: Navigation;
  title: string;
  description?: string;
  image?: ApiImage | null;
  path: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  /** Editor preview: never load tracking. */
  preview?: boolean;
  /** Origins the page shows in an iframe (job portal), for the CSP – see lib/csp.ts: frameOrigins. */
  frameSources?: string[];
}
const { settings, nav, title, description, image, path, noindex, jsonLd, preview = false, frameSources = [] } = Astro.props;
const analytics = preview ? null : settings.site.analytics;

// Content-Security-Policy sources that depend on settings (base policy: astro.config.ts).
// Images: own origin, data: URIs from the CSS, the media host. Requests: forms API and Umami.
const umamiScript = originOf(analytics?.script_url);
const umamiHost = originOf(analytics?.host_url) || umamiScript;
Astro.csp?.insertDirective(`img-src ${sources(MEDIA_ORIGIN)} data:`);
Astro.csp?.insertDirective(`connect-src ${sources(originOf(import.meta.env.PUBLIC_FORMS_API_URL), umamiHost)}`);
Astro.csp?.insertDirective(frameSources.length ? `frame-src ${frameSources.join(" ")}` : "frame-src 'none'");
Astro.csp?.insertScriptHash(sha256(FIT_HEADINGS_SCRIPT));
if (umamiScript) {
  // Replaces Astro's default script source, so 'self' has to be listed again.
  Astro.csp?.insertScriptResource("'self'");
  Astro.csp?.insertScriptResource(umamiScript);
}
const fullTitle = title.includes("Grabnar") ? title : `${title} – Grabnar Gebäudereinigung`;
---
<!doctype html>
<html lang="de" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Right after the two meta elements: the headline font is needed for the first paint,
         but the character set has to be settled before the parser reads anything else. -->
    <link rel="preload" href="/fonts/manrope-800.woff2" as="font" type="font/woff2" crossorigin />
    <Seo title={fullTitle} description={description} image={image ?? settings.site.default_og_image} path={path} noindex={noindex} jsonLd={jsonLd} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2d78bc" />
    {analytics && <Analytics config={analytics} contact={settings.contact} />}
  </head>
  <body class="flex min-h-full flex-col">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:p-3">Zum Inhalt springen</a>
    <Header nav={nav} site={settings.site} phone={settings.contact.phone} currentPath={path} />
    <main id="inhalt" data-track-area="content"><slot /></main>
    <Footer nav={nav} settings={settings} />
    <FitHeadings />
  </body>
</html>
