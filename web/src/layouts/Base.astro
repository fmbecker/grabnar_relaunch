---
import "@/styles/global.css";
import type { ApiImage, Navigation, Settings } from "@/lib/types";
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
interface Props {
  settings: Settings;
  nav: Navigation;
  title: string;
  description?: string;
  image?: ApiImage | null;
  path: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}
const { settings, nav, title, description, image, path, noindex, jsonLd } = Astro.props;
const fullTitle = title.includes("Grabnar") ? title : `${title} – Grabnar Gebäudereinigung`;
---
<!doctype html>
<html lang="de" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={fullTitle} description={description} image={image ?? settings.site.default_og_image} path={path} noindex={noindex} jsonLd={jsonLd} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2d78bc" />
    {settings.site.analytics && <script defer data-domain={settings.site.analytics.site_id} src={settings.site.analytics.script_url}></script>}
  </head>
  <body class="flex min-h-full flex-col">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:p-3">Zum Inhalt springen</a>
    <Header nav={nav} site={settings.site} phone={settings.contact.phone} currentPath={path} />
    <main id="inhalt"><slot /></main>
    <Footer nav={nav} settings={settings} />
  </body>
</html>
