---
import type { ApiLink } from "@/lib/types";
import Icon from "./Icon.astro";
interface Props { link: ApiLink; class?: string }
const { link, class: cls = "" } = Astro.props;
const styles = { primary: "btn-primary", secondary: "btn-secondary", link: "btn-link" };
---
<a href={link.href} class={`${styles[link.style] ?? "btn-primary"} ${cls}`} rel={link.external ? "noopener" : undefined}>
  {link.label}{link.style === "link" && <Icon name="arrow" class="h-4 w-4" />}
</a>
