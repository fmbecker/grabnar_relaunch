---
import type { Navigation, SiteSettings } from "@/lib/types";
import Icon from "@/components/ui/Icon.astro";
interface Props { nav: Navigation; site: SiteSettings; phone: string; currentPath: string }
const { nav, site, phone, currentPath } = Astro.props;
const isActive = (href: string) => href !== "/" && currentPath.startsWith(href);
const tel = `tel:${phone.replace(/[^\d+]/g, "")}`;
---
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/95 backdrop-blur">
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 font-bold text-brand-700">
      {site.logo ? (
        <img src={site.logo.url} srcset={`${site.logo.url} 1x, ${site.logo.url2x} 2x`} alt="M. B. Grabnar GmbH – Startseite" class="h-14 w-auto" width={site.logo.width} height={site.logo.height} />
      ) : (
        <span class="text-lg">M. B. Grabnar</span>
      )}
    </a>

    <!-- Desktop: hover/focus dropdowns, no JS -->
    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm font-medium">
        {nav.items.map((item) => (
          <li class="group relative">
            <a href={item.href} class:list={["flex items-center gap-1 rounded-md px-3 py-2 hover:bg-ink-50 hover:text-brand-700", isActive(item.href) && "text-brand-700"]} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.title}
              {item.children && item.children.length > 0 && <svg class="h-3 w-3" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>}
            </a>
            {item.children && item.children.length > 0 && (
              <ul class="invisible absolute left-0 top-full z-50 w-64 rounded-md border border-ink-100 bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                {item.children.map((c) => (
                  <li><a href={c.href} class:list={["block rounded px-3 py-2 hover:bg-ink-50 hover:text-brand-700", currentPath === c.href && "text-brand-700"]}>{c.title}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a href={tel} class="btn-primary hidden whitespace-nowrap xl:inline-flex"><Icon name="phone" class="h-4 w-4" />{phone}</a>

    <!-- Mobile: details/summary, categories expandable -->
    <details class="relative lg:hidden">
      <summary class="btn-secondary cursor-pointer list-none px-3 py-2" aria-label="Menü öffnen">Menü</summary>
      <ul class="absolute right-0 mt-2 max-h-[75vh] w-72 overflow-y-auto rounded-md border border-ink-100 bg-white p-2 shadow-lg">
        {nav.items.map((item) =>
          item.children && item.children.length > 0 ? (
            <li>
              <details>
                <summary class="flex cursor-pointer list-none items-center justify-between rounded px-3 py-2 font-medium hover:bg-ink-50">{item.title}<span aria-hidden="true">+</span></summary>
                <ul class="mb-1 ml-3 border-l border-ink-100 pl-2 text-sm">
                  <li><a href={item.href} class="block rounded px-3 py-1.5 font-semibold text-brand-700">Übersicht</a></li>
                  {item.children.map((c) => <li><a href={c.href} class="block rounded px-3 py-1.5 hover:bg-ink-50">{c.title}</a></li>)}
                </ul>
              </details>
            </li>
          ) : (
            <li><a href={item.href} class="block rounded px-3 py-2 font-medium hover:bg-ink-50">{item.title}</a></li>
          ),
        )}
        <li class="mt-2 border-t border-ink-100 pt-2"><a href={tel} class="block px-3 py-2 font-semibold text-brand-700">{phone}</a></li>
      </ul>
    </details>
  </div>
</header>
