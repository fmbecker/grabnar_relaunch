---
import type { ApiImage } from "@/lib/types";
import { ALLOW_INDEXING, SITE_URL } from "@/lib/site";
interface Props {
  title: string;
  description?: string;
  image?: ApiImage | null;
  path: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}
const { title, description = "", image, path, noindex = false, jsonLd } = Astro.props;
const site = SITE_URL;
// Staging domain: no page is indexable, whatever the page itself says.
const robotsNoindex = noindex || !ALLOW_INDEXING;
const canonical = new URL(path, site).toString();
// Social networks want roughly 1200 px at about 2:1, so the stage set is the right one.
// Picked by width, not by index, so reordering the set cannot silently change the OG image.
const ogRendition = image ? (image.renditions.stage.find((r) => r.width >= 1200) ?? image.renditions.stage.at(-1)) : null;
const ogImage = ogRendition ? new URL(ogRendition.url, site).toString() : null;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robotsNoindex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="de_DE" />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
