---
import type { Navigation, Settings } from "@/lib/types";
interface Props { nav: Navigation; settings: Settings }
const { nav, settings } = Astro.props;
const { contact, site } = settings;
---
<footer class="mt-auto bg-ink-900 text-ink-300">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-bold text-white">{contact.company_name}</p>
      {site.footer_text && <p class="mt-3 max-w-md text-sm">{site.footer_text}</p>}
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Kontakt</h2>
      <address class="mt-3 text-sm not-italic leading-relaxed">
        {contact.street}<br />{contact.postal_code} {contact.city}<br />
        <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="hover:text-white">{contact.phone}</a><br />
        <a href={`mailto:${contact.email}`} class="hover:text-white">{contact.email}</a>
      </address>
      {contact.opening_hours.length > 0 && <ul class="mt-3 text-sm">{contact.opening_hours.map((l) => <li>{l}</li>)}</ul>}
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Navigation</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.items.map((i) => <li><a href={i.href} class="hover:text-white">{i.title}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-700">
    <div class="container-x flex flex-col gap-3 py-5 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {contact.company_name}</p>
      <ul class="flex flex-wrap gap-4">
        {site.footer_links.map((l) => <li><a href={l.href} class="hover:text-white" rel={l.external ? "noopener" : undefined}>{l.label}</a></li>)}
        {site.social_links.map((s) => <li><a href={s.url} class="capitalize hover:text-white" rel="noopener" target="_blank">{s.platform}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
