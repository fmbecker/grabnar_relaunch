---
import type { ServiceGridValue } from "@/lib/types";
import Icon from "@/components/ui/Icon.astro";
import Picture from "@/components/ui/Picture.astro";
interface Props { value: ServiceGridValue }
const { value } = Astro.props;
const isCategories = value.kind === "categories";
---
<section class="section bg-ink-50">
  <div class="container-x">
    {value.heading && <h2 class="h2">{value.heading}</h2>}
    {value.intro && <p class="mt-3 max-w-2xl text-ink-700">{value.intro}</p>}

    {isCategories ? (
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {value.services.map((c) => (
          <li class="flex flex-col overflow-hidden rounded-lg border border-ink-100 bg-white shadow-sm">
            {c.image && <a href={c.href} tabindex="-1" aria-hidden="true"><Picture image={c.image} variant="wide" sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[16/7] w-full object-cover" /></a>}
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-3">
                <span class="rounded-md bg-brand-600 p-2 text-white"><Icon name={c.icon} class="h-6 w-6" /></span>
                <h3 class="text-xl font-bold"><a href={c.href} class="hover:text-brand-700">{c.title}</a></h3>
              </div>
              {c.children && c.children.length > 0 && (
                <ul class="mt-3 grid gap-x-6 text-sm sm:grid-cols-2">
                  {c.children.map((s) => (
                    <li><a href={s.href} class="inline-block py-1 text-ink-700 hover:text-brand-700 hover:underline">{s.title}</a></li>
                  ))}
                </ul>
              )}
              <a href={c.href} class="btn-link mt-auto pt-5 text-sm">Alle Leistungen <Icon name="arrow" class="h-4 w-4" /></a>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {value.services.map((s) => (
          <li>
            <a href={s.href} class="group flex h-full flex-col overflow-hidden rounded-lg border border-ink-100 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              {s.image && <Picture image={s.image} variant="card" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />}
              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center gap-3">
                  <span class="rounded-md bg-brand-50 p-2 text-brand-700"><Icon name={s.icon} class="h-5 w-5" /></span>
                  <h3 class="h3 group-hover:text-brand-700">{s.title}</h3>
                </div>
                <p class="mt-3 text-sm text-ink-700">{s.teaser}</p>
                <span class="btn-link mt-auto pt-4 text-sm">Mehr erfahren <Icon name="arrow" class="h-4 w-4" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
