---
import type { FactsValue } from "@/lib/types";
import Icon from "@/components/ui/Icon.astro";
interface Props { value: FactsValue }
const { value } = Astro.props;
---
<section aria-label="Auf einen Blick" class="panel-wrap pt-3 sm:pt-4">
  <ul class="mx-auto grid max-w-[87rem] grid-cols-2 gap-2 sm:gap-3 md:flex md:flex-wrap">
    {value.items.map((item) => (
      <li class="card flex min-h-14 flex-1 items-center gap-2.5 rounded-2xl px-4 py-3 text-sm font-extrabold sm:text-base md:px-5 last:odd:col-span-2">
        <Icon name="check" class="h-5 w-5 shrink-0 text-brand-500" />{item}
      </li>
    ))}
  </ul>
</section>
