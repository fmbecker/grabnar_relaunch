---
import type { FaqValue } from "@/lib/types";
interface Props { value: FaqValue }
const { value } = Astro.props;
---
<section class="section">
  <div class="container-x max-w-3xl">
    {value.heading && <h2 class="h2 mb-6">{value.heading}</h2>}
    <div class="card divide-y divide-ink-100 overflow-hidden">
      {value.items.map((item) => (
        <details class="group p-5 sm:px-7" data-track-toggle="faq-open" data-track-label={item.question}>
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between font-extrabold">
            {item.question}
            <span class="ml-4 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-50 text-xl text-brand-600 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="prose-site mt-3 text-sm" set:html={item.answer} />
        </details>
      ))}
    </div>
  </div>
</section>
