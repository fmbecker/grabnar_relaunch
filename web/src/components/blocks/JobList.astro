---
import type { JobListValue } from "@/lib/types";
import JobFilter from "@/components/islands/JobFilter";
import Icon from "@/components/ui/Icon.astro";
import { EVENT, umami } from "@/lib/analytics";
interface Props { value: JobListValue }
const { value } = Astro.props;
---
<section class="section" id="stellen">
  <div class="container-x">
    {value.heading && <h2 class="h2 mb-8">{value.heading}</h2>}
    {value.jobs.length === 0 ? (
      <p class="text-ink-700">{value.empty_text}</p>
    ) : value.show_filter ? (
      <JobFilter client:idle jobs={value.jobs} />
    ) : (
      <ul class="border-t-4 border-brand-500">
        {value.jobs.map((j) => (
          <li><a href={j.href} {...umami(EVENT.jobOpen, { job: j.title })} class="group flex items-center justify-between gap-6 border-b border-ink-100 bg-white px-1 py-6 hover:bg-brand-50 sm:px-4">
            <div><h3 class="h3 group-hover:text-brand-700">{j.title}</h3><p class="mt-2 text-ink-700">{j.location} · {j.employment_type_label} · {j.start_date}</p></div>
            <span class="grid h-11 w-11 shrink-0 place-items-center bg-brand-500 text-white"><Icon name="arrow" class="h-5 w-5" /></span>
          </a></li>
        ))}
      </ul>
    )}
  </div>
</section>
