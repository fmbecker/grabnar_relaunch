---
import type { StatsValue } from "@/lib/types";
interface Props { value: StatsValue }
const { value } = Astro.props;
---
<section class="panel-wrap section-sm">
  <dl class="panel panel-pad on-dark grid grid-cols-2 gap-8 bg-deep-900 text-center text-white lg:grid-cols-4">
    {value.stats.map((s) => (
      <div><dd class="text-4xl font-extrabold tracking-tight">{s.value}</dd><dt class="mt-1 text-sm text-deep-100">{s.label}</dt></div>
    ))}
  </dl>
</section>
