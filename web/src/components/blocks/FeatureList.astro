---
import type { FeatureListValue } from "@/lib/types";
import Icon from "@/components/ui/Icon.astro";
import BrandPattern from "@/components/ui/BrandPattern.astro";
interface Props { value: FeatureListValue }
const { value } = Astro.props;
// Keep the company name on one line in the large headline
const heading = value.heading?.replace(/M\. ?B\. Grabnar/g, "M.\u00a0B.\u00a0Grabnar");
---
<section class="panel-wrap section-sm">
  <div class="panel on-dark relative isolate bg-deep-900 text-white">
    <BrandPattern seed={5} width={2400} class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-3/4 w-full opacity-40" />
    <div class="panel-pad grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        {heading && <h2 class="h2">{heading}</h2>}
      </div>
      <ul class="lg:col-span-7">
        {value.features.map((f) => (
          <li class="flex gap-5 border-t border-white/15 py-6 last:border-b">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-300/15 text-brand-300"><Icon name={f.icon} class="h-6 w-6" /></span>
            <div>
              <h3 class="h4 text-xl">{f.title}</h3>
              <p class="mt-1.5 text-deep-100">{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
