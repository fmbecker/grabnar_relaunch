---
import type { FeatureListValue } from "@/lib/types";
import Icon from "@/components/ui/Icon.astro";
interface Props { value: FeatureListValue }
const { value } = Astro.props;
---
<section class="section on-dark bg-brand-500 text-white">
  <div class="container-x">
    {value.heading && <h2 class="h2 max-w-3xl">{value.heading}</h2>}
    <ul class="mt-12 grid gap-px border-y border-white/30 bg-white/30 md:grid-cols-3">
      {value.features.map((f) => (
        <li class="bg-brand-500 py-8 md:px-8 md:[&:nth-child(3n+1)]:pl-0">
          <Icon name={f.icon} class="h-8 w-8" />
          <h3 class="h3 mt-5">{f.title}</h3>
          <p class="mt-3 text-white">{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
