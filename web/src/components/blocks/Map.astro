---
/**
 * MapBlock: our address next to a map of the location.
 *
 * The tiles come from our own `/tiles/` proxy (deploy/nginx/site.conf), so the visitor's
 * browser never contacts a third party and the page CSP stays at `img-src 'self'`. That is
 * why this block needs no consent notice, unlike the job portal embed in JobEmbed.astro.
 *
 * Leaflet ships with the site (no CDN) and is loaded only once the map scrolls into view,
 * so pages that carry a map keep their Lighthouse score. Without JavaScript – or if the
 * script fails – the address and the OpenStreetMap link stay in place.
 */
import type { ContactSettings, MapValue } from "@/lib/types";
import { EVENT, umami } from "@/lib/analytics";
interface Props { value: MapValue; contact: ContactSettings }
const { value, contact } = Astro.props;

const { latitude: lat, longitude: lon } = contact;
const hasPosition = typeof lat === "number" && typeof lon === "number";
const q = encodeURIComponent(`${contact.street}, ${contact.postal_code} ${contact.city}`);
const osm = hasPosition
  ? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=${value.zoom}/${lat}/${lon}`
  : `https://www.openstreetmap.org/search?query=${q}`;
const where = `${contact.company_name}, ${contact.street}, ${contact.postal_code} ${contact.city}`;
---
<section class="section">
  <div class="container-x grid gap-8 lg:grid-cols-2">
    <div>
      {value.heading && <h2 class="h2 mb-4">{value.heading}</h2>}
      <address class="not-italic leading-relaxed text-ink-700">
        <strong class="text-ink-900">{contact.company_name}</strong><br />{contact.street}<br />{contact.postal_code} {contact.city}
      </address>
      <p class="mt-4">
        <a class="btn-link" href={osm} rel="noopener" target="_blank" {...umami(EVENT.outbound, { host: "openstreetmap.org" })}>
          Auf OpenStreetMap anzeigen
        </a>
      </p>
    </div>
    {hasPosition ? (
      <div
        class="aspect-[4/3] overflow-hidden rounded-lg bg-ink-100"
        data-map
        data-lat={String(lat)}
        data-lon={String(lon)}
        data-zoom={String(value.zoom)}
        aria-label={`Karte mit dem Standort ${where}`}
      ></div>
    ) : (
      <div class="flex aspect-[4/3] items-center justify-center rounded-lg bg-ink-100 p-6 text-center text-sm text-ink-700">
        Für die Kartenansicht fehlen die Koordinaten in den Kontakt-Einstellungen.
      </div>
    )}
  </div>
</section>

<script>
  import "leaflet/dist/leaflet.css";

  const boxes = document.querySelectorAll<HTMLElement>("[data-map]");

  async function show(box: HTMLElement) {
    const lat = Number(box.dataset.lat);
    const lon = Number(box.dataset.lon);
    const zoom = Number(box.dataset.zoom) || 14;
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

    const L = (await import("leaflet")).default;
    // Leaflet builds its zoom and pan animations at runtime, so no stylesheet reaches them;
    // they have to be switched off here when the visitor asked for less motion.
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const map = L.map(box, {
      center: [lat, lon],
      zoom,
      // Scrolling the page must not zoom the map; a click enables the wheel.
      scrollWheelZoom: false,
      attributionControl: false,
      zoomAnimation: !calm,
      fadeAnimation: !calm,
      markerZoomAnimation: !calm,
    });
    map.once("click", () => map.scrollWheelZoom.enable());

    L.tileLayer("/tiles/{z}/{x}/{y}.png", { maxZoom: 18, minZoom: 5 }).addTo(map);

    // The OSMF tile usage policy requires visible attribution; `prefix` carries the
    // "report a map issue" link it asks for.
    L.control
      .attribution({
        position: "bottomright",
        prefix: '<a href="https://www.openstreetmap.org/fixthemap" rel="noopener" target="_blank">Fehler melden</a>',
      })
      .addAttribution('&copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap</a>-Mitwirkende')
      .addTo(map);

    // No image marker: an inline pin keeps img-src at 'self' and needs no asset path.
    L.marker([lat, lon], {
      keyboard: false,
      interactive: false,
      icon: L.divIcon({
        className: "grabnar-pin",
        iconSize: [28, 36],
        iconAnchor: [14, 36],
        html:
          '<svg viewBox="0 0 28 36" width="28" height="36" aria-hidden="true" focusable="false">' +
          '<path d="M14 0C6.8 0 1 5.8 1 13c0 9.2 11.4 21.5 11.9 22a1.5 1.5 0 0 0 2.2 0C15.6 34.5 27 22.2 27 13 27 5.8 21.2 0 14 0Z" fill="#21588b"/>' +
          '<circle cx="14" cy="13" r="5" fill="#fff"/></svg>',
      }),
    }).addTo(map);
  }

  if (boxes.length) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          void show(entry.target as HTMLElement);
        }
      },
      { rootMargin: "200px" },
    );
    boxes.forEach((box) => io.observe(box));
  }
</script>

<style is:global>
  /* Leaflet builds its controls at runtime, so these rules cannot be scoped. They only
     align the plugin with the site: our font, readable attribution, visible focus. */
  .leaflet-container {
    font: inherit;
    background: var(--color-ink-100);
  }
  .leaflet-control-attribution {
    background: rgb(255 255 255 / 0.9);
    color: var(--color-ink-700);
    font-size: 0.75rem;
  }
  .leaflet-control-attribution a {
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .leaflet-control-zoom a {
    color: var(--color-ink-900);
  }
  .leaflet-container a:focus-visible,
  .leaflet-control-zoom a:focus-visible {
    outline: 3px solid var(--color-brand-500);
    outline-offset: 2px;
  }
</style>
