---
import type { CtaValue } from "@/lib/types";
import LinkButton from "@/components/ui/LinkButton.astro";
interface Props { value: CtaValue; service?: string }
const { value, service } = Astro.props;
---
<section class="section">
  <div class="container-x">
    <div class="flex flex-col items-start gap-6 rounded-xl bg-brand-50 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <div><h2 class="h2">{value.heading}</h2>{value.text && <p class="mt-2 text-ink-700">{value.text}</p>}</div>
      <LinkButton block="cta" link={value.link} service={service} class="shrink-0" />
    </div>
  </div>
</section>
