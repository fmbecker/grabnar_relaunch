---
import type { GalleryValue } from "@/lib/types";
import Picture from "@/components/ui/Picture.astro";
interface Props { value: GalleryValue }
const { value } = Astro.props;
---
<section class="section">
  <div class="container-x">
    {value.heading && <h2 class="h2 mb-8">{value.heading}</h2>}
    <ul class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {value.images.map((img) => (
        <li><a href={img.renditions.full.url} target="_blank" rel="noopener"><Picture image={img} variant="card" sizes="(min-width: 768px) 33vw, 50vw" class="aspect-[4/3] w-full rounded-md object-cover" /></a></li>
      ))}
    </ul>
  </div>
</section>
