---
import type { HeroValue } from "@/lib/types";
import Picture from "@/components/ui/Picture.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import BrandPattern from "@/components/ui/BrandPattern.astro";
interface Props { value: HeroValue }
const { value } = Astro.props;
---
<section class="on-dark relative overflow-hidden bg-brand-500 text-white">
  <div class="container-x grid gap-10 pt-10 sm:pt-14 lg:grid-cols-12 lg:gap-12 lg:py-20">
    <div class="flex flex-col justify-center lg:col-span-7">
      {value.motto && (
        <blockquote class="mb-6 text-lg italic">„{value.motto}“</blockquote>
      )}
      <h1 class="h1">{value.headline}</h1>
      {value.subline && <p class="lead mt-6 max-w-[38ch]">{value.subline}</p>}
      {value.links.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-3">
          {value.links.map((l) => (
            <LinkButton block="hero" link={l} class={l.style === "secondary" ? "btn-secondary-on-dark" : ""} />
          ))}
        </div>
      )}
    </div>
    <!-- Picture: cut at an angle like the logo's roofs; drawn towers until the company's photos arrive -->
    <div class="relative -mx-4 h-64 bg-brand-600 [clip-path:polygon(0_18%,100%_0,100%_100%,0_100%)] sm:-mx-6 sm:h-80 lg:col-span-5 lg:mx-0 lg:h-auto lg:min-h-[34rem] lg:[clip-path:polygon(16%_0,100%_0,100%_100%,0_100%)]">
      {value.image ? (
        <Picture image={value.image} variant="hero" loading="eager" sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
      ) : (
        <BrandPattern class="absolute inset-0 h-full w-full" />
      )}
    </div>
  </div>
</section>
