---
import type { HeroValue } from "@/lib/types";
import Picture from "@/components/ui/Picture.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import BrandPattern from "@/components/ui/BrandPattern.astro";
interface Props { value: HeroValue }
const { value } = Astro.props;
---
<!-- Stage: one large rounded panel. The photo fills it; the text sits on a dark veil at the bottom left.
     Drawn towers stand in until the company's photos arrive. -->
<section class="panel-wrap pt-3 sm:pt-5">
  <div class="panel on-dark relative isolate flex min-h-[32rem] flex-col justify-end bg-deep-900 text-white sm:min-h-[36rem] lg:min-h-[42rem]">
    {value.image ? (
      <>
        <Picture image={value.image} variant="hero" loading="eager" sizes="(min-width: 1440px) 1392px, 100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" />
        <div class="absolute inset-0 -z-10 bg-deep-900/70 lg:bg-transparent lg:bg-linear-to-r lg:from-deep-900 lg:from-25% lg:via-deep-900/75 lg:to-deep-900/10" aria-hidden="true"></div>
      </>
    ) : (
      <BrandPattern width={2400} class="absolute inset-x-0 bottom-0 -z-10 h-full w-full" />
    )}
    <div class="panel-pad max-w-4xl">
      {value.motto && (
        <blockquote class="mb-5 inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold italic sm:text-base">„{value.motto}“</blockquote>
      )}
      <!-- Headline breaks only between words (no hyphenation inside a word); size scales with the viewport so the longest word fits -->
      <h1 class="h1 hyphens-none [overflow-wrap:normal]">{value.headline}</h1>
      {value.subline && <p class="lead mt-6 max-w-[40ch] text-white">{value.subline}</p>}
      {value.links.length > 0 && (
        <div class="mt-9 flex flex-wrap gap-3">
          {value.links.map((l) => (
            <LinkButton block="hero" link={l} class={`min-h-14 px-7 ${l.style === "secondary" ? "btn-secondary-on-dark" : ""}`} />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
