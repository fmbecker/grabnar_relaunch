---
import type { HeroValue } from "@/lib/types";
import Picture from "@/components/ui/Picture.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import BrandPattern from "@/components/ui/BrandPattern.astro";
interface Props { value: HeroValue }
const { value } = Astro.props;
---
<section class="on-dark relative isolate overflow-hidden bg-brand-500 text-white">
  <div class="container-x relative z-10 grid pt-10 sm:pt-14 lg:min-h-[38rem] lg:grid-cols-12 lg:items-center lg:py-20">
    <div class="flex flex-col justify-center lg:col-span-7">
      {value.motto && (
        <blockquote class="mb-6 text-lg italic">„{value.motto}“</blockquote>
      )}
      <!-- Headline breaks only between words (no hyphenation inside a word); size scales with the viewport so the longest word fits -->
      <h1 class="h1 hyphens-none [overflow-wrap:normal]">{value.headline}</h1>
      {value.subline && <p class="lead mt-6 max-w-[38ch]">{value.subline}</p>}
      {value.links.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-3">
          {value.links.map((l) => (
            <LinkButton block="hero" link={l} class={l.style === "secondary" ? "btn-secondary-on-dark" : ""} />
          ))}
        </div>
      )}
    </div>
  </div>
  <!-- Picture layer, landscape like the photos: mobile a band under the text that fades upwards; desktop the right
       half of the stage, full height up to the viewport edge, fading to the left at an angle like the logo's roofs
       (173deg/98deg keep the former slant; the transparent start is offset so no corner of the layer shows). Drawn towers until the company's photos arrive -->
  <div class="mt-10 relative aspect-[16/10] [mask-image:linear-gradient(173deg,transparent_12vw,black_calc(12vw_+_38%))] sm:aspect-[2/1] lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-[56%] xl:w-[62%] lg:mt-0 lg:[mask-image:linear-gradient(98deg,transparent_100px,black_calc(100px_+_40%))]">
    {value.image ? (
      <Picture image={value.image} variant="hero" loading="eager" sizes="(min-width: 1280px) 62vw, (min-width: 1024px) 56vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
    ) : (
      <BrandPattern class="absolute inset-0 h-full w-full" />
    )}
  </div>
</section>
