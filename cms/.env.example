# Copy to .env (dev) or /srv/grabnar/cms.env (server). Values below: phase 1 (staging on
# mbg.aivii.de). For the domain switch (phase 2) replace mbg.aivii.de with www.grabnar.de in
# ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, WAGTAILADMIN_BASE_URL, FRONTEND_URL, CORS_ALLOWED_ORIGINS
# – docs/09-domainumzug.md. Then: docker compose up -d (restart cms) and rebuild the frontend.
DJANGO_SETTINGS_MODULE=grabnar.settings.production
SECRET_KEY=change-me
ALLOWED_HOSTS=mbg.aivii.de,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://mbg.aivii.de
DATABASE_URL=postgres://grabnar:grabnar@db:5432/grabnar
# Links in admin mails and in the API
WAGTAILADMIN_BASE_URL=https://mbg.aivii.de
# Public frontend (Astro) – used for preview, CORS and the subject of form mails
FRONTEND_URL=https://mbg.aivii.de
# Local rebuild webhook (deploy/rebuild-hook.py), empty = disabled
FRONTEND_BUILD_HOOK_URL=http://127.0.0.1:9000/rebuild
FRONTEND_BUILD_HOOK_SECRET=change-me
# Mail for form submissions. Sender under aivii.de (SPF/DKIM managed there), not grabnar.de:
# the grabnar.de DNS isn't ours, mail from this server with an @grabnar.de sender would fail SPF.
# Submitted forms set Reply-To to the visitor's address.
EMAIL_URL=smtp+tls://website%40aivii.de:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Website Grabnar <website@aivii.de>
FORMS_NOTIFY_EMAIL=info@grabnar.de
# Hosts the block "Stellenangebote (externes Portal)" may embed (comma-separated, https only)
# JOB_EMBED_ALLOWED_HOSTS=grabnar.recruit.zvoove.cloud
# Comma-separated hosts allowed to call the forms API
CORS_ALLOWED_ORIGINS=https://mbg.aivii.de
