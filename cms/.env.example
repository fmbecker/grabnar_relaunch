# Copy to .env (dev) or provide via environment (production)
DJANGO_SETTINGS_MODULE=grabnar.settings.production
SECRET_KEY=change-me
ALLOWED_HOSTS=www.grabnar.de,grabnar.de,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://www.grabnar.de
DATABASE_URL=postgres://grabnar:grabnar@db:5432/grabnar
WAGTAILADMIN_BASE_URL=https://www.grabnar.de
# Public frontend (Astro) – used for preview, sitemap and CORS
FRONTEND_URL=https://www.grabnar.de
# Local rebuild webhook (deploy/rebuild-hook.py), empty = disabled
FRONTEND_BUILD_HOOK_URL=http://127.0.0.1:9000/rebuild
FRONTEND_BUILD_HOOK_SECRET=change-me
# Mail for form submissions
EMAIL_URL=smtp://user:pass@smtp.example.com:587/?tls=True
DEFAULT_FROM_EMAIL=website@grabnar.de
FORMS_NOTIFY_EMAIL=info@grabnar.de
# Comma-separated hosts allowed to call the forms API
CORS_ALLOWED_ORIGINS=https://www.grabnar.de
