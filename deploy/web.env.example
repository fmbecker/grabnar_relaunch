# /srv/grabnar/web.env – read by deploy/build-web.sh (also when the CMS triggers a rebuild).
# Changing it takes effect with the next build: /srv/grabnar/repo/deploy/build-web.sh

# Phase 1 – staging on the new VPS, behind basic auth, not indexed:
PUBLIC_SITE_URL=https://mbg.aivii.de
PUBLIC_ALLOW_INDEXING=false

# Phase 2 – after the DNS switch (docs/09-domainumzug.md):
# PUBLIC_SITE_URL=https://www.grabnar.de
# PUBLIC_ALLOW_INDEXING=true

# Optional, defaults: $PUBLIC_SITE_URL/api/forms, http://127.0.0.1:8000/api/v2, same-origin media
# PUBLIC_FORMS_API_URL=
# WAGTAIL_API_URL=
# WAGTAIL_MEDIA_URL=
