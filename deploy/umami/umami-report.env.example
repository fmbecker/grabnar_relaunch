# Copy to /srv/grabnar/umami-report.env (chmod 600). Used by send-monthly-report.sh.
UMAMI_URL=http://127.0.0.1:3000
# Umami → Einstellungen → API-Schlüssel (read access is enough for the report)
UMAMI_API_KEY=umami_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Umami → Einstellungen → Websites → www.grabnar.de
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Comma-separated. Placeholder until the recipient question (docs/04-aufgaben.md) is settled.
REPORT_RECIPIENTS=felix@example.com
