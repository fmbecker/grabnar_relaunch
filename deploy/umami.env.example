# Copy to /srv/grabnar/umami.env (mode 600). Read by the umami service in
# deploy/docker-compose.yml. Umami keeps its own database in the same Postgres
# container as the CMS; create it once (deploy/README.md, step 9).
#
#   APP_SECRET:        openssl rand -hex 32   (changing it logs everyone out)
#   DATABASE_URL:      the password set when the umami role was created
DATABASE_URL=postgresql://umami:change-me@db:5432/umami
APP_SECRET=change-me
