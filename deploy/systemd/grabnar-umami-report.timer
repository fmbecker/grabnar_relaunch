[Unit]
Description=Weekly Umami website report (Mondays, 07:15)

[Timer]
# Montags, damit der Bericht die abgeschlossene Woche von Montag bis Sonntag abdeckt.
# Mit Zeitzone: die Serveruhr läuft auf UTC, der Bericht rechnet in Europe/Berlin – ohne den
# Zusatz käme er im Winter um 08:15 Uhr deutscher Zeit und im Sommer um 09:15 Uhr.
OnCalendar=Mon 07:15:00 Europe/Berlin
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
